<?xml version="1.0"?>
<ruleset name="Custom PMD Rules"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

  <description>Custom ruleset for Practice 7 - Code Metrics</description>

  <!--
    LoC (Lines of Code) 指标之一：类级别代码长度
    ExcessiveClassLength 会在“单个类代码行数过多”时报告，帮助识别过大的类（可维护性下降）。
  -->
  <rule ref="category/java/design.xml/ExcessiveClassLength" />

  <!--
    LoC 指标二：方法级别代码长度
    ExcessiveMethodLength 会在“单个方法过长”时报告，提示该方法可能职责过多，适合拆分。
  -->
  <rule ref="category/java/design.xml/ExcessiveMethodLength" />

  <!--
    CC (Cyclomatic Complexity) 圈复杂度
    methodReportLevel=10: 方法圈复杂度 >= 10 报告
    classReportLevel=80: 类内方法复杂度累计很高时报告（整体复杂度风险）
  -->
  <rule ref="category/java/design.xml/CyclomaticComplexity">
    <properties>
      <property name="methodReportLevel" value="10"/>
      <property name="classReportLevel" value="80"/>
    </properties>
  </rule>

  <!--
    CBO (Coupling Between Objects) 对象耦合度
    threshold=20: 当类依赖的不同对象类型太多时报告，耦合过高会增加修改影响面。
  -->
  <rule ref="category/java/design.xml/CouplingBetweenObjects">
    <properties>
      <property name="threshold" value="20"/>
    </properties>
  </rule>

  <!--
    WMC (Weighted Methods per Class) 近似实现
    PMD 没有直接名为 WMC 的独立规则，这里用 TooManyMethods 近似表达“类方法负担过重”。
    maxmethods=20: 类的方法数量超过 20 时报告。
  -->
  <rule ref="category/java/design.xml/TooManyMethods">
    <properties>
      <property name="maxmethods" value="20"/>
    </properties>
  </rule>

  <!--
    LCOM (Lack of Cohesion in Methods) 近似实现
    PMD 同样没有直接名为 LCOM 的单独规则，这里使用 GodClass 作为近似：
    当类表现为“低内聚 + 高复杂 + 职责过多”时会被报告。
  -->
  <rule ref="category/java/design.xml/GodClass" />

</ruleset>
